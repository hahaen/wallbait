{
  "name": "wallbait",
  "version": "0.1.0",
  "private": true,
  "description": "撞墙了么 · 你追你的，墙就在那儿。",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && vite build",
    "build:mapp": "node mapp/build.mjs",
    "preview": "vite preview",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "replays:generate": "GENERATE_REPLAYS=1 vitest run tests/solutions.test.ts",
    "test:static": "npm run build && playwright test --config playwright.static.config.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "^5.1.0"
  }
}
